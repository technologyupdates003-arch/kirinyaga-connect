          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1
            },
            "event_date": {
              "description": "YYYY-MM-DD",
              "type": "string"
            },
            "event_time": {
              "type": "string"
            },
            "location": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "agenda": {
              "type": "string"
            },
            "status": {
              "default": "upcoming",
              "type": "string",
              "enum": [
                "upcoming",
                "past",
                "cancelled"
              ]
            },
            "cover_image_url": {
              "type": "string",
              "format": "uri"
            },
            "rsvp_url": {
              "type": "string",
              "format": "uri"
            },
            "gallery_url": {
              "type": "string",
              "format": "uri"
            }
          },
          "required": [
            "title"
          ]
        },
        "outputSchema": null
      },
