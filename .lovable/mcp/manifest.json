    "tools": [
      {
        "name": "list_events",
        "title": "List events",
        "description": "List KHCWW events, optionally filtered by status (upcoming, past, cancelled).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "status": {
              "description": "Filter by event status.",
              "type": "string",
              "enum": [
                "upcoming",
                "past",
                "cancelled"
              ]
            },
            "limit": {
              "description": "Max rows to return (default 50).",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "create_event",
        "title": "Create event",
        "description": "Create a new KHCWW event. Requires admin role (enforced by RLS).",
