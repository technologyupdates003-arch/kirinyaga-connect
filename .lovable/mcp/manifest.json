            "rsvp_url": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uri"
                },
                {
                  "type": "null"
                }
              ]
            },
            "gallery_url": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uri"
